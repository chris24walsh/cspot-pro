APP_ENV=production
APP_NAME=cspot-pro
PUBLIC_APP_URL=http://localhost
API_CORS_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cspot:change-me@db:5432/cspot

AUTH_SECRET_KEY=change-me-before-public-hosting
SESSION_COOKIE_SECURE=false

# Optional SMTP settings for invites, password resets, and test email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_FROM_NAME=cspot-pro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Optional OBS control for sermon recording/broadcast operation.
OBS_WEBSOCKET_HOST=host.docker.internal
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=change-me
OBS_RECORDINGS_DIR=/app/storage/recordings
OBS_AUDIO_CACHE_DIR=/app/storage/recording-audio
FFMPEG_PATH=ffmpeg
