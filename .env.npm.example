APP_ENV=production
APP_NAME=cspot-pro

# Use the final externally visible URL that Nginx Proxy Manager will serve.
API_CORS_ORIGINS=https://cspot.yourdomain.com

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://cspot:change-me-to-a-long-random-password@db:5432/cspot

AUTH_SECRET_KEY=change-me-to-a-long-random-secret
SESSION_COOKIE_SECURE=true
