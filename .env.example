APP_ENV=local
APP_NAME=cspot-pro
PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=cspot
DATABASE_URL=postgresql+psycopg://cspot:cspot@db:5432/cspot

VITE_API_BASE_URL=http://localhost:8000

# Optional SMTP settings for invites, password resets, and test email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=cspot-pro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Optional OBS control for sermon recording/broadcast operation.
# In OBS: Tools -> WebSocket Server Settings -> Enable WebSocket server.
OBS_WEBSOCKET_HOST=
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=
OBS_RECORDINGS_DIR=/app/storage/recordings
OBS_AUDIO_CACHE_DIR=/app/storage/recording-audio
FFMPEG_PATH=ffmpeg
