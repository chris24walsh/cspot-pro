APP_ENV=local
APP_NAME=cspot-pro
PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=cspot
DATABASE_URL=postgresql+psycopg://cspot:cspot@db:5432/cspot

VITE_API_BASE_URL=http://localhost:8000

# Optional SMTP settings for invites and password resets. Mailtrap works nicely here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=cspot-pro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
