APP_ENV=local
APP_NAME=cspot-pro
PUBLIC_APP_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=cspot
DATABASE_URL=postgresql+psycopg://cspot:cspot@db:5432/cspot

VITE_API_BASE_URL=http://localhost:8000

# Optional SMTP settings for invites, password resets, and test email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=cspot-pro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Remote speakers: browser ICE discovery and optional coturn REST-auth relay.
REMOTE_ICE_SERVERS_JSON='[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":"stun:stun.l.google.com:19302"}]'
REMOTE_TURN_URLS=
REMOTE_TURN_SECRET=
