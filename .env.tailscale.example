APP_ENV=production
APP_NAME=cspot-pro
PUBLIC_APP_URL=https://your-hostname.your-tailnet.ts.net

# Same-origin hosting via nginx means CORS is mostly irrelevant here, but set the
# final Tailscale origin anyway for clarity and future API tooling.
API_CORS_ORIGINS=https://your-hostname.your-tailnet.ts.net

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://cspot:change-me-to-a-long-random-password@db:5432/cspot

AUTH_SECRET_KEY=change-me-to-a-long-random-secret
SESSION_COOKIE_SECURE=true

# Optional SMTP settings for invites and password resets. Mailtrap works nicely here.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@your-hostname.your-tailnet.ts.net
SMTP_FROM_NAME=cspot-pro
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Optional shared Google Drive integration for sermon deck import.
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_DRIVE_PROJECT_NUMBER=123456789012
