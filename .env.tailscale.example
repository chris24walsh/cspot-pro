APP_ENV=production
APP_NAME=cspot-pro

# Same-origin hosting via nginx means CORS is mostly irrelevant here, but set the
# final Tailscale origin anyway for clarity and future API tooling.
API_CORS_ORIGINS=https://your-hostname.your-tailnet.ts.net

POSTGRES_DB=cspot
POSTGRES_USER=cspot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://cspot:change-me-to-a-long-random-password@db:5432/cspot

AUTH_SECRET_KEY=change-me-to-a-long-random-secret
SESSION_COOKIE_SECURE=true
