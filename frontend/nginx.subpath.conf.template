server {
    listen 80;
    server_name _;
    # Use relative Location headers so redirects do not leak the internal Docker hostname.
    absolute_redirect off;

    # Phone camera photos commonly exceed nginx's 1 MB default request limit.
    client_max_body_size 50m;

    root /usr/share/nginx/html;
    index index.html;

    location = __APP_BASE_PATH__ {
        try_files /index.html =404;
    }

    location = __APP_BASE_PATH__/api/v1/broadcast/live-audio {
        proxy_pass http://api:8000/api/v1/broadcast/live-audio;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location __APP_BASE_PATH__/api/ {
        proxy_pass http://api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = __APP_BASE_PATH__/docs {
        proxy_pass http://api:8000/docs;
    }

    location = __APP_BASE_PATH__/openapi.json {
        proxy_pass http://api:8000/openapi.json;
    }

    location = __APP_BASE_PATH__/manifest.webmanifest {
        alias /usr/share/nginx/html/manifest.webmanifest;
        default_type application/manifest+json;
    }

    location = __APP_BASE_PATH__/camera-playback-auth {
        internal;
        proxy_pass http://api:8000/api/v1/broadcast/playback-authorized;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-CSpot-Playback-Source $arg_src;
        proxy_set_header X-CSpot-Playback-URI $request_uri;
    }

    location = __APP_BASE_PATH__/camera/api/ws {
        auth_request __APP_BASE_PATH__/camera-playback-auth;
        proxy_pass __CAMERA_PROXY_UPSTREAM__api/ws;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade "websocket";
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = __APP_BASE_PATH__/camera/api/stream.m3u8 {
        auth_request __APP_BASE_PATH__/camera-playback-auth;
        proxy_pass __CAMERA_PROXY_UPSTREAM__api/stream.m3u8;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location __APP_BASE_PATH__/camera/api/hls/ {
        auth_request __APP_BASE_PATH__/camera-playback-auth;
        proxy_pass __CAMERA_PROXY_UPSTREAM__api/hls/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Only expose browser playback. In particular, never proxy go2rtc's
    # configuration or stream-inspection APIs, which include upstream URLs.
    location __APP_BASE_PATH__/camera/ {
        return 404;
    }

    location __APP_BASE_PATH__/ {
        rewrite ^__APP_BASE_PATH__/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }
}
