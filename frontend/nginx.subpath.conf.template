map $http_x_forwarded_proto $cspot_redirect_to_https {
    default 0;
    http 1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    if ($cspot_redirect_to_https) {
        return 308 https://$host$request_uri;
    }

    location = __APP_BASE_PATH__ {
        return 302 __APP_BASE_PATH__/;
    }

    location __APP_BASE_PATH__/api/ {
        proxy_pass http://api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = __APP_BASE_PATH__/docs {
        proxy_pass http://api:8000/docs;
    }

    location = __APP_BASE_PATH__/openapi.json {
        proxy_pass http://api:8000/openapi.json;
    }

    location __APP_BASE_PATH__/camera/ {
        proxy_pass __CAMERA_PROXY_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location __APP_BASE_PATH__/ {
        rewrite ^__APP_BASE_PATH__/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }
}
