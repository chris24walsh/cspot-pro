FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY frontend/package.json frontend/package.json

RUN npm ci

COPY frontend frontend

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_APP_BASE_PATH=/
ENV VITE_APP_BASE_PATH=${VITE_APP_BASE_PATH}
ARG VITE_PUBLIC_WEBSITE_URL=/
ENV VITE_PUBLIC_WEBSITE_URL=${VITE_PUBLIC_WEBSITE_URL}
RUN npm run build --workspace frontend

FROM nginx:1.27-alpine

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.root.conf /tmp/nginx.root.conf
COPY frontend/nginx.subpath.conf.template /tmp/nginx.subpath.conf.template

ARG VITE_APP_BASE_PATH=/
ENV VITE_APP_BASE_PATH=${VITE_APP_BASE_PATH}
ARG CAMERA_PROXY_UPSTREAM=http://192.168.2.208:1984/
ENV CAMERA_PROXY_UPSTREAM=${CAMERA_PROXY_UPSTREAM}

RUN APP_BASE_PATH="${VITE_APP_BASE_PATH%/}" \
    && CAMERA_PROXY_UPSTREAM="${CAMERA_PROXY_UPSTREAM}" \
    && if [ -z "$APP_BASE_PATH" ]; then APP_BASE_PATH="/"; fi \
    && if [ "$APP_BASE_PATH" = "/" ]; then \
        sed "s|__CAMERA_PROXY_UPSTREAM__|$CAMERA_PROXY_UPSTREAM|g" /tmp/nginx.root.conf > /etc/nginx/conf.d/default.conf; \
      else \
        sed -e "s|__APP_BASE_PATH__|$APP_BASE_PATH|g" -e "s|__CAMERA_PROXY_UPSTREAM__|$CAMERA_PROXY_UPSTREAM|g" /tmp/nginx.subpath.conf.template > /etc/nginx/conf.d/default.conf; \
      fi

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
