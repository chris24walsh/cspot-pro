# Copy to .env.sandbox on the sandbox host. Never use production secrets or data.
APP_ENV=sandbox
APP_NAME=cspot-pro-sandbox
PUBLIC_APP_URL=https://sandbox-host.example.ts.net:8443
API_CORS_ORIGINS=https://sandbox-host.example.ts.net:8443
POSTGRES_DB=cspot_sandbox
POSTGRES_USER=cspot_sandbox
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://cspot_sandbox:replace-with-a-long-random-value@db:5432/cspot_sandbox
AUTH_SECRET_KEY=replace-with-an-independent-long-random-value
SESSION_COOKIE_SECURE=true
SANDBOX_HTTP_PORT=18080
SANDBOX_HTTPS_PORT=8443
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=cspot-pro sandbox
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
